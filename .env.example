# ============================================================
# SINZU — Environment Variables (LOCAL)
# ============================================================
# This file is git-ignored — safe for real credentials.
# For Vercel deployment, add these same values in
# Vercel Dashboard > Settings > Environment Variables.
# ============================================================


# ── SQUARE (payments + catalog) ────────────────────────────
# Sandbox for testing, Production for live payments.
# Get keys: https://developer.squareup.com/apps

# Server-side (secret — never sent to browser)
SQUARE_ACCESS_TOKEN=REPLACE_WITH_PRODUCTION_ACCESS_TOKEN
SQUARE_ENVIRONMENT=production

# Browser-facing (safe to expose; card form needs these)
NEXT_PUBLIC_SQUARE_APPLICATION_ID=REPLACE_WITH_PRODUCTION_APP_ID
NEXT_PUBLIC_SQUARE_LOCATION_ID=REPLACE_WITH_PRODUCTION_LOCATION_ID
NEXT_PUBLIC_SQUARE_ENVIRONMENT=production


# ── RESEND (transactional email) ───────────────────────────
# Get key: https://resend.com/api-keys
# Verify sinzu.shop domain first: https://resend.com/domains

RESEND_API_KEY=REPLACE_WITH_NEW_RESEND_KEY
MAIL_FROM="SINZU <hello@sinzu.shop>"
MAIL_REPLY_TO=hello@sinzu.shop
OWNER_EMAIL=hello@sinzu.shop


# ── SITE URL ────────────────────────────────────────────────
# Used in emails, sitemap, structured data, OG tags.
# For local dev: http://localhost:3000
# For production: https://sinzu.shop

NEXT_PUBLIC_SITE_URL=https://sinzu.shop
